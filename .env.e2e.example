# Template for .env.e2e (which is gitignored and chmod 600).
#
# The live e2e suite runs the real agent loop against a real model, so it needs
# an OpenAI-compatible gateway with tool-calling support.
#
#   cp .env.e2e.example .env.e2e
#   $EDITOR .env.e2e
#   bash scripts/e2e.sh

# Base URL, including the /v1 suffix.
export QM_E2E_ENDPOINT="https://your-gateway.example.com/v1"

# Bearer key for that gateway.
export QM_E2E_API_KEY="replace-me"

# A model that supports tool calling. The agent loop is useless without it.
export QM_E2E_MODEL="openai/gpt-5.6-sol"
